// Cloudhal site Worker for Cloudhal
// Generated by `cloudhal deploy`; resource ids are filled in by wrangler on first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudhal-com-site",
  "main": "@cloudhal/astro-renderer/cloudflare-entry",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudhal-com-db",
      "database_id": "8a350f9c-88f1-4da7-81c7-a36ffd74edd3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "cloudhal-com-blobs"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cloudhal_com_events"
    }
  ],
  "vars": {
    "CLOUDHAL_SITE_ID": "site_8DTHH9QRG8CAMYKHENBW",
    "CLOUDHAL_ANALYTICS": "on",
    "CLOUDHAL_ANALYTICS_DEFAULTS": "{\"enabled\":true,\"uniqueVisitors\":false,\"vitalsOneIn\":5}",
    "CLOUDHAL_SITE_HOSTS": "cloudhal.com",
    "CLOUDHAL_REDIRECT_HOSTS": "www.cloudhal.com",
    "CLOUDHAL_REDIRECT_TO": "cloudhal.com"
  },
  "routes": [
    {
      "pattern": "cloudhal.com",
      "custom_domain": true
    },
    {
      "pattern": "www.cloudhal.com",
      "custom_domain": true
    }
  ],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
