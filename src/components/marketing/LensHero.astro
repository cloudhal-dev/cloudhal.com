---
/**
 * The `lens-hero` block (src/blocks.ts): the brand lens as a page's opening scene. The lens sits
 * between the headline and the actions and comes out of the dark: it lights up once, then its
 * light slowly swells and fades, follows the pointer a little and dims as the page scrolls on
 * (lens.ts). Under it, one line of the activity log at a time. Every word comes from the props.
 * Without JavaScript, at motion "none" or under reduced motion: a still, lit lens and the whole log.
 */
import { external, href } from "./href.ts";

type LensState = "watching" | "working" | "waiting" | "live";
interface Props {
  props: {
    eyebrow?: string;
    heading: string;
    highlight?: string;
    body?: string;
    primaryLabel: string;
    primaryHref: string;
    secondaryLabel?: string;
    secondaryHref?: string;
    logLabel: string;
    log: { text: string; state: LensState }[];
    pauseLabel: string;
    playLabel: string;
  };
}
const { props } = Astro.props;
const primary = href(props.primaryHref);
const secondary = href(props.secondaryHref);

// The highlighted words, when they occur in the heading, are split out to take the gradient.
const at = props.highlight ? props.heading.indexOf(props.highlight) : -1;
const parts =
  at >= 0 && props.highlight
    ? [props.heading.slice(0, at), props.highlight, props.heading.slice(at + props.highlight.length)]
    : [props.heading, "", ""];
const first = props.log[0]?.state ?? "watching";
---
<section class="mk-lens" data-lens data-state={first} aria-labelledby="mk-lens-title">
  <div class="mk-lens__inner">
    <div class="mk-lens__top">
      {props.eyebrow && <p class="mk-lens__eyebrow">{props.eyebrow}</p>}
      <h1 id="mk-lens-title" class="mk-lens__title">
        {parts[0]}{parts[1] && <span class="mk-lens__highlight">{parts[1]}</span>}{parts[2]}
      </h1>
    </div>
    <div class="mk-lens__stage" aria-hidden="true">
      <div class="mk-lens__halo"></div>
      <svg class="mk-lens__svg" viewBox="-300 -300 600 600" focusable="false">
        <defs>
          <radialGradient id="mk-lens-bezel" cx="-60" cy="-90" r="420" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#3a2a22" />
            <stop offset="0.55" stop-color="#140c09" />
            <stop offset="1" stop-color="#050302" />
          </radialGradient>
          <linearGradient id="mk-lens-metal" x1="-300" y1="-300" x2="300" y2="300" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#b9a296" />
            <stop offset="0.35" stop-color="#3b2c25" />
            <stop offset="0.7" stop-color="#1a110d" />
            <stop offset="1" stop-color="#6e5a4f" />
          </linearGradient>
          <radialGradient id="mk-lens-glass" cx="0" cy="0" r="240" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#1c0c06" />
            <stop offset="0.7" stop-color="#070403" />
            <stop offset="1" stop-color="#020101" />
          </radialGradient>
          <radialGradient id="mk-lens-light" cx="0" cy="0" r="150" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#fffaf4" />
            <stop offset="0.1" stop-color="#ffe6cc" />
            <stop offset="0.26" stop-color="#ffb27a" />
            <stop offset="0.5" stop-color="#f6821f" />
            <stop offset="0.74" stop-color="#b4441f" stop-opacity="0.75" />
            <stop offset="1" stop-color="#5a200c" stop-opacity="0" />
          </radialGradient>
        </defs>
        <g class="mk-lens__body">
          <circle r="288" fill="url(#mk-lens-bezel)" />
          <circle r="286" fill="none" stroke="url(#mk-lens-metal)" stroke-width="3" />
          <circle r="244" fill="url(#mk-lens-glass)" />
          <circle r="244" fill="none" stroke="#f6c3ad" stroke-opacity="0.12" stroke-width="1.5" />
          <circle r="196" fill="none" stroke="#f6c3ad" stroke-opacity="0.07" stroke-width="1" />
        </g>
        <g class="mk-lens__iris">
          <g class="mk-lens__light">
            <circle r="150" fill="url(#mk-lens-light)" />
          </g>
          <g class="mk-lens__pupil">
            <circle r="18" fill="#ffffff" />
          </g>
        </g>
        <circle class="mk-lens__ping" r="160" />
        <path class="mk-lens__glass" d="M -170 -120 A 210 210 0 0 1 60 -205 A 230 230 0 0 0 -150 -60 Z" />
      </svg>
    </div>
    <div class="mk-lens__bottom">
      {props.body && <p class="mk-lens__body-text">{props.body}</p>}
      <p class="mk-lens__actions">
        {primary && <a class="mk-button mk-button--primary" href={primary} rel={external(primary) ? "noopener" : undefined}>{props.primaryLabel}</a>}
        {props.secondaryLabel && secondary && <a class="mk-button mk-lens__ghost" href={secondary} rel={external(secondary) ? "noopener" : undefined}>{props.secondaryLabel}</a>}
      </p>
      <div class="mk-lens__status">
        <p class="mk-lens__status-label">{props.logLabel}</p>
        <ol>
          {props.log.map((item, i) => (
            <li data-state={item.state} data-step={i}><span class="mk-lens__dot" aria-hidden="true"></span>{item.text}</li>
          ))}
        </ol>
        <button class="mk-lens__pause" type="button" data-lens-toggle data-pause={props.pauseLabel} data-play={props.playLabel} hidden>{props.pauseLabel}</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountLenses } from "./lens.ts";
  mountLenses();
</script>
