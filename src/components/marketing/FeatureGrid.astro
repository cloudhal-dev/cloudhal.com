---
/** The `feature-grid` block (src/blocks.ts): a heading and cards with curated icons. */
import { renderIcon } from "@cloudhal/core-ts/icons";
import { iconSet } from "../../icons.ts";

interface Item {
  title: string;
  body: string;
  icon?: string;
}
interface Props {
  props: { eyebrow?: string; heading: string; intro?: string; items: Item[] };
}
const { props } = Astro.props;
---
<div class="mk-band">
  {props.eyebrow && <p class="mk-eyebrow">{props.eyebrow}</p>}
  <h2 class="mk-heading">{props.heading}</h2>
  {props.intro && <p class="mk-intro">{props.intro}</p>}
  <ul class="mk-grid">
    {props.items.map((item) => (
      <li class="mk-card">
        {item.icon && <span class="mk-card__icon" set:html={renderIcon(item.icon, { set: iconSet })} />}
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </li>
    ))}
  </ul>
</div>
